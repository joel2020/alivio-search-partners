# HubSpot Forms API — contact form submissions
# Find both values in HubSpot: Marketing > Forms > (your form) > Share > Embed code
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# HubSpot form for candidate applications (until an ATS is chosen)
HUBSPOT_APPLY_FORM_GUID=

# Cal.com booking — the event link shown on /contact#book
# defaults to alivio/intro-call30 (the existing live event) if unset
NEXT_PUBLIC_CAL_LINK=
